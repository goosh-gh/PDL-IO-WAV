#!/usr/bin/env perl
# extend_wav_plateau.pl
#
# 何をするスクリプトか:
#   WAV(PCM 8/16/32bit または float 32/64bit)の「立ち上がり」と「立ち下がり」は
#   そのまま残し、その間の平坦部(プラトー)を繰り返しコピーして長い WAV を作る。
#   STIM009 の電圧確認用に standard.wav を延長する用途。
#
#   つなぎ目でプチ音(段差)が出ないように、
#     1. 繰り返し区間 [a, b) の終わり b を、b の前後の波形が a の前後の波形と
#        最もよく一致する位置に選ぶ(正弦波なら位相のそろう位置 = 整数周期)
#     2. 繰り返しは区間まるごと(整数回)だけ使い、途中で切らない。
#        そのため出力長は --dur に最も近い「区間長の整数倍」にそろう
#   つなぎ目での段差(b-1 → a の差)と、通常の隣接サンプル差の最大値を表示する。
#
# 使い方:
#   perl extend_wav_plateau.pl standard.wav --dur 10
#     第1引数  入力WAV($ARGV[0])。出力は入力のbasenameに _<dur>s を付けた名前で
#              カレントディレクトリに書き出す(例: standard_10s.wav)
#     --dur   出力の全長(秒)。実際の長さは区間長の整数倍に丸められる
#     --thr   平坦部の自動検出しきい値(5 ms ブロックごとの最大振幅が
#             全体最大の thr 倍以上のところを平坦部とする。既定 0.98)
#     --a/--b 平坦部の開始/終了の目安を秒で手動指定(自動検出を上書き)。
#             b はこの位置から手前に向かって一致の良い位置を探す
#     --search 終点 b を探す範囲(秒, 既定 0.05)。最低周波数の 1 周期以上にする

use strict;
use warnings;
use Getopt::Long;
use File::Basename qw(fileparse);
use PDL;

my ($dur, $thr, $ta, $tb, $search) = (undef, 0.98, undef, undef, 0.05);
GetOptions('dur=f' => \$dur, 'thr=f' => \$thr, 'a=f' => \$ta, 'b=f' => \$tb,
           'search=f' => \$search) or die "bad options\n";
my $infile = $ARGV[0];
defined $infile or die "使い方: perl $0 input.wav --dur 秒\n";
defined $dur    or die "--dur (秒) を指定してください\n";

# 出力名: <入力のbasename>_<dur>s.wav をカレントディレクトリに
my ($base) = fileparse($infile, qr/\.[^.]*$/);
my $outfile = "${base}_${dur}s.wav";

# ---- WAV 読み込み(チャンクを走査して fmt と data を取り出す) ----
open my $fh, '<:raw', $infile or die "open $infile: $!";
my $raw = do { local $/; <$fh> }; close $fh;
substr($raw, 0, 4) eq 'RIFF' && substr($raw, 8, 4) eq 'WAVE' or die "RIFF/WAVE ではありません\n";
my ($tag, $ch, $rate, $bits, $bytes);
my $pos = 12;
while ($pos + 8 <= length $raw) {
    my ($id, $size) = unpack 'a4 V', substr($raw, $pos, 8);
    if ($id eq 'fmt ') {
        ($tag, $ch, $rate, undef, undef, $bits) = unpack 'v v V V v v', substr($raw, $pos + 8, 16);
    } elsif ($id eq 'data') {
        $bytes = substr($raw, $pos + 8, $size);
        last;
    }
    $pos += 8 + $size + ($size & 1);
}
defined $bytes && defined $tag or die "fmt/data チャンクが見つかりません\n";
$tag = 1 if $tag == 0xFFFE;    # WAVE_FORMAT_EXTENSIBLE は整数PCMとして扱う

my $type;
if    ($tag == 1 && $bits == 8)  { $type = byte }
elsif ($tag == 1 && $bits == 16) { $type = short }
elsif ($tag == 1 && $bits == 32) { $type = long }
elsif ($tag == 3 && $bits == 32) { $type = float }
elsif ($tag == 3 && $bits == 64) { $type = double }
else { die "未対応の形式: tag=$tag bits=$bits\n" }

my $big_endian = (unpack('N', pack('L', 1)) == 1);   # WAV は little-endian
sub swap { my ($p) = @_; return unless $big_endian && $bits > 8;
           $p->bswap2 if $bits == 16; $p->bswap4 if $bits == 32; $p->bswap8 if $bits == 64 }

my $nbytes_per = $bits / 8;
my $n = int(length($bytes) / ($nbytes_per * $ch));
my $x = zeroes($type, $ch, $n);                      # dims: (チャンネル, 時間)
${ $x->get_dataref } = substr($bytes, 0, $n * $ch * $nbytes_per);
$x->upd_data;
swap($x);

my $d = $x->double;                                  # 解析用(符号付き double)
$d -= 128 if $tag == 1 && $bits == 8;                # 8bit は符号なし(中心128)

# ---- 平坦部の目安 [a, bmax) ----
my ($a, $bmax);
my $B = int(0.005 * $rate) || 1;                     # 5 ms ブロック
if (defined $ta && defined $tb) {
    ($a, $bmax) = (int($ta * $rate + 0.5), int($tb * $rate + 0.5));
} else {
    my $nb   = int($n / $B);
    my $blk  = abs($d->slice(':,0:' . ($nb * $B - 1)))->maximum      # (n) チャンネル最大
                  ->reshape($B, $nb)->maximum;                         # (nb) ブロック最大
    my $idx  = which($blk >= $thr * $blk->max);
    # 立ち上がり/立ち下がりにかかるブロックを避けて 1 ブロックずつ内側に入る
    $a    = ($idx->min->sclr + 1) * $B;
    $bmax = ($idx->max->sclr)     * $B;
}

# ---- 終点 b を探す: b 前後の波形が a 前後の波形と最も一致する位置 ----
my $m  = 16;                                         # 比較する片側サンプル数
my $S  = int($search * $rate);
my $lo = $bmax - $S; $lo = $a + $m + 1 if $lo < $a + $m + 1;
($a - $m >= 0 && $bmax + $m <= $n && $lo < $bmax)
    or die "平坦部が短すぎるか範囲が不正: a=$a bmax=$bmax n=$n\n";
my $ref  = $d->slice(':,' . ($a - $m) . ':' . ($a + $m - 1));        # (ch, 2m)
my $cand = sequence(long, $bmax - $lo + 1) + $lo;                     # 候補 b
my $off  = sequence(long, 2 * $m) - $m;
my $win  = $d->dice_axis(1, ($off->dummy(1, $cand->nelem) + $cand->dummy(0, 2 * $m))->flat)
             ->reshape($ch, 2 * $m, $cand->nelem);                    # (ch, 2m, ncand)
my $err  = (($win - $ref) ** 2)->sumover->sumover;                    # (ncand)
my $b    = $cand->at($err->minimum_ind);
my $L    = $b - $a;

# ---- 切り貼り: 立ち上がり + 区間の整数回繰り返し + 立ち下がり ----
my $head = $x->slice(':,0:' . ($a - 1));
my $loop = $x->slice(":,$a:" . ($b - 1));
my $tail = $x->slice(":,$b:-1");
my $mid_target = int($dur * $rate + 0.5) - $head->dim(1) - $tail->dim(1);
$mid_target >= 0 or die "--dur が短すぎます(立ち上がり+立ち下がりだけで超えています)\n";
my $reps = int($mid_target / $L + 0.5); $reps = 1 if $reps < 1;
my $mid  = $loop->dummy(2, $reps)->copy->reshape($ch, $L * $reps);
my $y    = $head->glue(1, $mid, $tail)->copy;

# ---- つなぎ目の段差チェック ----
# 2階差分 s[i+1]-2s[i]+s[i-1] は波形の「折れ」に敏感。つなぎ目(… b-2, b-1 | a, a+1 …)
# での値と、区間内での最大値を比べる
my $j    = $d->slice(':,' . ($b - 2) . ':' . ($b - 1))->glue(1, $d->slice(":,$a:" . ($a + 1)));
my $c2_join = abs($j->slice(':,2:-1') - 2 * $j->slice(':,1:-2') + $j->slice(':,0:-3'))->max;
my $seg  = $d->slice(":,$a:" . ($b - 1));
my $c2_norm = abs($seg->slice(':,2:-1') - 2 * $seg->slice(':,1:-2') + $seg->slice(':,0:-3'))->max;
printf STDERR "入力 %d サンプル (%.4f s), rate=%d, ch=%d\n", $n, $n / $rate, $rate, $ch;
printf STDERR "繰り返し区間 [%d,%d) = %d サンプル (%.5f s) × %d 回\n", $a, $b, $L, $L / $rate, $reps;
printf STDERR "つなぎ目の折れ(2階差分) %.4g / 区間内の最大 %.4g\n", $c2_join, $c2_norm;
warn "注意: つなぎ目の折れが区間内より大きい。--search を広げるか --a/--b を見直してください\n"
    if $c2_join > 1.1 * $c2_norm;

# ---- WAV 書き出し ----
my $total = $y->dim(1);
swap($y);
my $data  = ${ $y->get_dataref };
my $align = $ch * $nbytes_per;
my $hdr = pack('a4 V a4 a4 V v v V V v v a4 V',
    'RIFF', 36 + length($data), 'WAVE', 'fmt ', 16,
    $tag, $ch, $rate, $rate * $align, $align, $bits, 'data', length($data));
open my $out, '>:raw', $outfile or die "open $outfile: $!";
print $out $hdr, $data;
close $out;
printf STDERR "出力 %s: %d サンプル (%.4f s)\n", $outfile, $total, $total / $rate;
